---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import { formatDate, tagFilterPath } from '../../lib/content/entries';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  updatedDate?: Date;
  locale: Locale;
  tags?: string[];
}

const { title, description, date, updatedDate, locale, tags = [] } = Astro.props;

const showUpdated = updatedDate && (!date || updatedDate.getTime() > date.getTime());
---

<header class="mb-10">
  <h1 class="text-step-3 leading-tight font-bold tracking-tight">{title}</h1>
  {description && <p class="mt-3 text-step-0 leading-relaxed text-fg-muted">{description}</p>}

  <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-step--1 text-fg-muted">
    {
      date && date.getTime() > 0 && (
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:calendar" class="h-4 w-4" />
          <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
        </span>
      )
    }
    {
      showUpdated && (
        <span class="inline-flex items-center gap-1.5">
          <Icon name="lucide:refresh-cw" class="h-3.5 w-3.5" />
          <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, locale)}</time>
        </span>
      )
    }
    {
      tags.length > 0 && (
        <span class="flex flex-wrap items-center gap-1.5">
          {tags.map((tag) => (
            <a
              href={tagFilterPath(locale, tag)}
              class="rounded-full bg-muted px-2.5 py-1 text-xs transition-colors duration-200 hover:bg-accent-bg hover:text-accent-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none"
            >
              #{tag}
            </a>
          ))}
        </span>
      )
    }
  </div>
</header>
