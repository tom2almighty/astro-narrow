---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import {
  entryDate,
  formatDate,
  localizedEntryPath,
  tagFilterPath
} from '../../lib/content/entries';

interface Props {
  entry: CollectionEntry<'posts'>;
  locale: Locale;
}

const { entry, locale } = Astro.props;
const href = localizedEntryPath('posts', entry);
const date = entryDate(entry);
const tags = entry.data.tags.slice(0, 4);
---

<article class="group">
  <a
    href={href}
    class="block rounded-base border border-border bg-canvas transition-colors duration-200 hover:border-border-strong hover:bg-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  >
    <div class="flex flex-col overflow-hidden rounded-[inherit] md:flex-row">
      <div class="flex flex-1 flex-col justify-center gap-3 p-5 sm:p-6">
        <h2
          class="text-step-1 leading-snug font-semibold transition-colors group-hover:text-accent-text"
        >
          {entry.data.title}
        </h2>
        {
          entry.data.description && (
            <p class="line-clamp-3 text-step--1 leading-relaxed text-fg-muted md:line-clamp-2">
              {entry.data.description}
            </p>
          )
        }

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-step--1 text-fg-muted">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:calendar" class="h-4 w-4" />
            <time datetime={date.toISOString()}>{formatDate(date, locale)}</time>
          </span>
          {
            tags.length > 0 && (
              <span class="flex flex-wrap items-center gap-1.5">
                {tags.map((tag) => (
                  <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs">#{tag}</span>
                ))}
              </span>
            )
          }
        </div>
      </div>

      {
        entry.data.cover && (
          <div class="order-first p-3 pb-0 md:order-last md:w-56 md:shrink-0 md:self-center md:p-3 md:pl-0">
            <div class="aspect-video overflow-hidden rounded-xs bg-muted">
              <img
                src={entry.data.cover}
                alt=""
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
          </div>
        )
      }
    </div>
  </a>
</article>
