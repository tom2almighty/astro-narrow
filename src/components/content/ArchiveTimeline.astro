---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import { entryDate, formatDate, localizedEntryPath } from '../../lib/content/entries';

interface Props {
  posts: Array<CollectionEntry<'posts'>>;
  locale: Locale;
}

const { posts, locale } = Astro.props;
const groups = posts.reduce<Record<string, Array<CollectionEntry<'posts'>>>>((acc, entry) => {
  const year = String(entryDate(entry).getFullYear());
  acc[year] ||= [];
  acc[year].push(entry);
  return acc;
}, {});
---

<div id="archive-results" class="relative mt-10">
  <div class="absolute top-2 bottom-0 left-4 w-px bg-border"></div>
  <div class="space-y-10">
    {Object.entries(groups).map(([year, entries]) => (
      <section data-archive-year={year} class="relative pl-12">
        <div class="absolute top-1 left-0 grid h-8 w-8 place-items-center rounded-base bg-accent text-xs font-semibold text-accent-contrast">
          {year.slice(2)}
        </div>
        <h2 class="text-step-2 font-semibold">{year}</h2>
        <div class="mt-4 divide-y divide-border overflow-hidden rounded-base border border-border bg-canvas">
          {entries.map((entry) => {
            const date = entryDate(entry);
            return (
              <a
                href={localizedEntryPath('posts', entry)}
                data-archive-entry
                data-tags={JSON.stringify(entry.data.tags || [])}
                class="grid gap-1 p-4 transition-colors duration-200 hover:bg-hover focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none sm:grid-cols-[9rem_1fr] sm:items-center"
              >
                <time class="text-step--1 text-fg-muted" datetime={date.toISOString()}>{formatDate(date, locale)}</time>
                <div>
                  <h3 class="font-medium">{entry.data.title}</h3>
                  {entry.data.description && <p class="mt-1 text-step--1 text-fg-muted">{entry.data.description}</p>}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</div>
