---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import { entryDate, formatDate, localizedEntryPath } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

interface Props {
  posts: Array<CollectionEntry<'posts'>>;
  locale: Locale;
}

const { posts, locale } = Astro.props;
const t = useTranslations(locale);
---

{posts.length > 0 && (
  <section class="mt-12 border-t border-border pt-8">
    <h2 class="text-step-1 font-semibold">{t('related.title')}</h2>
    <div class="mt-2">
      {posts.map((entry) => {
        const date = entryDate(entry);
        return (
          <article class="border-b border-border py-4 last:border-b-0">
            <a href={localizedEntryPath('posts', entry)} class="group flex items-center justify-between gap-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
              <div class="min-w-0">
                <h3 class="truncate font-medium transition-colors group-hover:text-accent-text">{entry.data.title}</h3>
                <time datetime={date.toISOString()} class="mt-1 block text-xs text-fg-muted">{formatDate(date, locale)}</time>
              </div>
              <Icon name="lucide:arrow-right" class="h-4 w-4 shrink-0 text-fg-muted transition-transform duration-200 group-hover:translate-x-1 group-hover:text-accent-text motion-reduce:transition-none" />
            </a>
          </article>
        );
      })}
    </div>
  </section>
)}
