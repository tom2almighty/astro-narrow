---
import type { Locale } from '../../config/i18n';
import type { ArchiveTerm } from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

interface Props {
  tags: ArchiveTerm[];
  total: number;
  locale: Locale;
}

const { tags, total, locale } = Astro.props;
const t = useTranslations(locale);
const termClass =
  'inline-flex min-h-7 items-center gap-1 rounded-full border border-border bg-canvas px-2.5 py-0.5 text-xs font-medium text-fg-muted transition-colors duration-200 hover:border-border-strong hover:bg-hover hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-accent-contrast aria-pressed:hover:bg-accent aria-pressed:hover:text-accent-contrast motion-reduce:transition-none';
---

<section
  data-archive-filter-root
  hidden
  class="mb-6 space-y-4 rounded-base border border-border bg-canvas p-4 sm:p-5"
  aria-label={t('archive.filter.label')}
>
  <fieldset>
    <legend class="sr-only">{t('archive.filter.tags')}</legend>
    <div class="sm:grid sm:grid-cols-[5.5rem_minmax(0,1fr)] sm:items-start sm:gap-4">
      <span aria-hidden="true" class="text-step--1 font-semibold text-fg sm:pt-1"
        >{t('archive.filter.tags')}</span
      >
      <div class="mt-2 flex min-w-0 flex-wrap gap-1.5 sm:mt-0">
        <button
          type="button"
          data-archive-filter-value=""
          aria-pressed="true"
          aria-controls="archive-results"
          class={termClass}
        >
          {t('archive.filter.all')}
          <span class="tabular-nums opacity-70">{total}</span>
        </button>
        {
          tags.map((term) => (
            <button
              type="button"
              data-archive-filter-value={term.value}
              aria-pressed="false"
              aria-controls="archive-results"
              class={termClass}
            >
              {term.value}
              <span class="tabular-nums opacity-60">{term.count}</span>
            </button>
          ))
        }
      </div>
    </div>
  </fieldset>

  <div class="border-t border-border pt-4 text-step--1 text-fg-muted">
    <p aria-live="polite" aria-atomic="true">
      {t('archive.results.prefix')}
      <strong data-archive-result-count class="font-semibold text-fg">{total}</strong>
      {t('archive.results.suffix')}
    </p>
    <p data-archive-empty hidden class="mt-3 rounded-base bg-muted px-4 py-3 text-fg">
      {t('archive.filter.empty')}
    </p>
  </div>
</section>

<script>
  import '../../scripts/archive-filters.ts';
</script>
