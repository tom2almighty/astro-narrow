---
import type { Locale } from '../../config/i18n';
import { formatDate } from '../../lib/content/entries';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  locale: Locale;
}

const { title, description, date, locale } = Astro.props;
---

<header class="mb-10">
  {
    date && (
      <time class="text-step--1 text-fg-muted" datetime={date.toISOString()}>
        {formatDate(date, locale)}
      </time>
    )
  }
  <h1 class="mt-2 text-step-3 font-bold tracking-tight">{title}</h1>
  {description && <p class="mt-4 max-w-2xl text-fg-muted">{description}</p>}
</header>
