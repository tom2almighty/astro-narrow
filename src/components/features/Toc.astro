---
import { Icon } from 'astro-icon/components';
import TocPanel from './TocPanel.astro';
import TocCapsule from './TocCapsule.astro';
import { defaultLocale, type Locale } from '../../config/i18n';
import { useTranslations } from '../../i18n/utils';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface TocSeriesItem {
  title: string;
  href: string;
  current: boolean;
  /** 0 表示父文,1..N 表示章节。 */
  position: number;
}

export interface TocSeries {
  title: string;
  href: string;
  position: number;
  total: number;
  items: TocSeriesItem[];
}

interface Props {
  headings: TocHeading[];
  position: 'center' | 'side';
  series?: TocSeries;
  locale?: Locale;
}

const { headings, position, series, locale = defaultLocale } = Astro.props;
const t = useTranslations(locale);
const filtered = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 4)
  .map((heading) => ({ ...heading, text: heading.text.replace(/#$/, '').trim() }));
const hasPanel = filtered.length > 0 || Boolean(series);
// The spine needs headings to draw ticks from; series-only entries stay on the capsule.
const useRail = position === 'side' && filtered.length > 0;
---

{
  hasPanel &&
    (useRail ? (
      <>
        {/* Below lg the gutter is too tight and touch has no hover: use the capsule. */}
        <TocCapsule headings={filtered} series={series} class="lg:hidden" />
        <aside
          data-toc-root
          class="toc-rail hidden lg:block"
          style={`--toc-count: ${filtered.length}`}
        >
          <div class="toc-rail-inner">
            <div class="toc-ticks" aria-hidden="true">
              {filtered.map((heading) => (
                <span
                  data-toc-tick
                  data-slug={heading.slug}
                  data-depth={heading.depth}
                  class="toc-tick"
                />
              ))}
            </div>
            <nav data-toc-panel class="toc-flyout glass" aria-label={t('toc.label')}>
              <button
                type="button"
                data-toc-pin
                class="toc-pin"
                aria-pressed="false"
                aria-label={t('toc.pin')}
                title={t('toc.pin')}
                data-label-pin={t('toc.pin')}
                data-label-unpin={t('toc.unpin')}
              >
                <Icon name="lucide:pin" class="toc-pin-on h-3.5 w-3.5" />
                <Icon name="lucide:pin-off" class="toc-pin-off h-3.5 w-3.5" />
              </button>
              <div data-toc-scroll class="toc-flyout-scroll">
                <TocPanel headings={filtered} series={series} />
              </div>
            </nav>
          </div>
        </aside>
      </>
    ) : (
      <TocCapsule headings={filtered} series={series} />
    ))
}
