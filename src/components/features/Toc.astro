---
import TocPanel from './TocPanel.astro';
import TocCapsule from './TocCapsule.astro';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

export interface TocSeriesItem {
  title: string;
  href: string;
  current: boolean;
  /** 0 表示父文,1..N 表示章节。 */
  position: number;
}

export interface TocSeries {
  title: string;
  href: string;
  position: number;
  total: number;
  items: TocSeriesItem[];
}

interface Props {
  headings: TocHeading[];
  position: 'center' | 'side';
  series?: TocSeries;
}

const { headings, position, series } = Astro.props;
const filtered = headings
  .filter((heading) => heading.depth >= 2 && heading.depth <= 4)
  .map((heading) => ({ ...heading, text: heading.text.replace(/#$/, '').trim() }));
const hasPanel = filtered.length > 0 || Boolean(series);
---

{
  hasPanel &&
    (position === 'center' ? (
      <TocCapsule headings={filtered} series={series} />
    ) : (
      <>
        {/* Below xl the side rail has no room; fall back to the capsule. */}
        <TocCapsule headings={filtered} series={series} class="xl:hidden" />
        <aside data-toc-root class="fixed top-24 right-4 z-30 hidden xl:block">
          <div class="group relative flex items-center justify-end">
            <div
              data-toc-bars
              class="flex flex-col items-end gap-1 transition-opacity duration-150 group-hover:pointer-events-none group-hover:opacity-0"
            >
              {filtered.map((heading) => (
                <a
                  href={`#${heading.slug}`}
                  data-toc-link
                  class="toc-bar block h-1 rounded-l-full bg-muted transition-all hover:bg-accent"
                  style={`width: ${Math.max(0.4, 1.15 - (heading.depth - 2) * 0.22)}rem`}
                  aria-label={heading.text}
                />
              ))}
            </div>
            <nav
              data-toc-panel
              class="glass absolute top-0 right-0 hidden max-h-[70vh] w-64 overflow-auto rounded-base border border-border p-2 text-step--1 group-hover:block"
            >
              <TocPanel headings={filtered} series={series} />
            </nav>
          </div>
        </aside>
      </>
    ))
}
