---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../config/i18n';
import { getLocalePath } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import { useTranslations } from '../../i18n/utils';
import PostList from '../content/PostList.astro';
import ViewAll from '../ui/ViewAll.astro';

interface Props {
  locale: Locale;
  recentPosts: Array<CollectionEntry<'posts'>>;
}

const { locale, recentPosts } = Astro.props;
const { author } = siteConfig;
const t = useTranslations(locale);

function assetPath(path: string) {
  if (/^(https?:)?\/\//.test(path) || path.startsWith('data:')) return path;
  const base = import.meta.env.BASE_URL || '/';
  return `${base.replace(/\/?$/, '/')}${path.replace(/^\//, '')}`;
}

const avatarSrc = assetPath(author.avatar);
---

<div class="space-y-fl-l">
  <section class="rounded-base border border-border bg-canvas px-7 py-5 sm:px-8 sm:py-6">
    <div
      class="flex flex-col items-center gap-6 text-center md:flex-row md:items-start md:text-left"
    >
      <img
        src={avatarSrc}
        alt={author.name}
        class="h-24 w-24 shrink-0 rounded-full border border-border object-cover"
      />

      <div class="min-w-0 flex-1">
        <h1 class="text-step-3 font-bold tracking-tight">{author.name}</h1>
        <p class="mt-1.5 text-step-0 text-fg-muted">{author.title[locale]}</p>
        <p class="mt-3 leading-relaxed text-fg">{author.description[locale]}</p>

        {
          author.social.length > 0 && (
            <div class="mt-5 flex flex-wrap items-center justify-center gap-2.5 md:justify-start">
              {author.social.map((item) => (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 rounded-base bg-muted px-3 py-2 text-step--1 font-medium text-fg-muted transition-colors duration-200 hover:bg-accent-bg hover:text-accent-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent motion-reduce:transition-none"
                  title={item.name}
                >
                  <Icon name={item.icon} class="h-4 w-4" />
                  <span>{item.name}</span>
                </a>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    recentPosts.length > 0 && (
      <section>
        <h2 class="mb-3 text-step-2 font-semibold">{t('home.recentPosts')}</h2>
        <PostList posts={recentPosts} locale={locale} />
        <div class="mt-6 flex justify-center">
          <ViewAll href={getLocalePath(locale, '/posts/')} locale={locale} />
        </div>
      </section>
    )
  }
</div>
