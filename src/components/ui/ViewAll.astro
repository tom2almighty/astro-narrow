---
import { Icon } from 'astro-icon/components';
import type { Locale } from '../../config/i18n';
import { useTranslations } from '../../i18n/utils';

interface Props {
  href: string;
  locale: Locale;
  label?: string;
}

const { href, locale, label } = Astro.props;
const t = useTranslations(locale);
---

<a
  href={href}
  class="group inline-flex min-h-10 items-center gap-2 rounded-base border border-border bg-canvas px-4 py-2 text-step--1 font-medium text-fg-muted transition-colors duration-200 hover:border-border-strong hover:bg-hover hover:text-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
>
  <span>{label ?? t('home.viewAll')}</span>
  <Icon
    name="lucide:arrow-right"
    class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5 motion-reduce:transition-none"
  />
</a>
