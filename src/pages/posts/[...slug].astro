---
import { render } from 'astro:content';
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/content/Breadcrumbs.astro';
import PostMeta from '../../components/content/PostMeta.astro';
import PostLicense from '../../components/content/PostLicense.astro';
import PostNavigation from '../../components/content/PostNavigation.astro';
import RelatedPosts from '../../components/content/RelatedPosts.astro';
import SeriesChapters from '../../components/content/SeriesChapters.astro';
import { defaultLocale, getLocalePath } from '../../config/i18n';
import { siteConfig } from '../../config/site';
import {
  adjacentEntries,
  entrySlug,
  excludeSubposts,
  getLocalizedEntries,
  getSeriesContext,
  localizedEntryPath,
  relatedPosts
} from '../../lib/content/entries';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getLocalizedEntries('posts', defaultLocale);
  return posts.map((entry) => ({ params: { slug: entrySlug(entry) }, props: { entry } }));
}

const locale = defaultLocale;
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const posts = await getLocalizedEntries('posts', locale);
const listPosts = excludeSubposts(posts);
const t = useTranslations(locale);

const seriesContext = getSeriesContext(entry, posts);
const adjacent = seriesContext
  ? { previous: seriesContext.previous, next: seriesContext.next }
  : adjacentEntries(listPosts, entry);
const related = relatedPosts(listPosts, entry, siteConfig.post.relatedCount);

const seriesMeta = seriesContext
  ? {
      title: seriesContext.series.parent.data.title,
      href: localizedEntryPath('posts', seriesContext.series.parent),
      position: seriesContext.position,
      total: seriesContext.series.subposts.length
    }
  : undefined;

const tocSeries =
  seriesContext && seriesMeta
    ? {
        ...seriesMeta,
        items: seriesContext.series.sequence.map((item, index) => ({
          title: index === 0 ? t('series.overview') : item.data.title,
          href: localizedEntryPath('posts', item),
          current: item.id === entry.id,
          position: index
        }))
      }
    : undefined;

const breadcrumbs = [
  { label: siteConfig.shortName, href: getLocalePath(locale, '/'), icon: 'lucide:home' },
  { label: t('posts.title'), href: getLocalePath(locale, '/posts/'), icon: 'lucide:file-text' },
  ...(seriesContext && seriesMeta && seriesContext.position > 0
    ? [{ label: seriesMeta.title, href: seriesMeta.href, icon: 'lucide:list-ordered' }]
    : []),
  { label: entry.data.title, icon: 'lucide:file-text' }
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={locale}
  headings={headings}
  toc={entry.data.toc ?? 'center'}
  series={tocSeries}
  comments={entry.data.comments}
>
  <Breadcrumbs locale={locale} items={breadcrumbs} />
  {
    entry.data.cover && (
      <div class="mb-8 overflow-hidden rounded-base">
        <img
          src={entry.data.cover}
          alt={entry.data.title}
          class="aspect-video max-h-[60vh] w-full object-cover"
          loading="eager"
        />
      </div>
    )
  }
  <PostMeta
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.date}
    updatedDate={entry.data.updatedDate}
    locale={locale}
    tags={entry.data.tags}
  />
  <article class="prose mb-12">
    <Content />
  </article>
  {
    seriesContext && seriesContext.position === 0 && (
      <SeriesChapters chapters={seriesContext.series.subposts} locale={locale} />
    )
  }
  <PostLicense locale={locale} />
  <PostNavigation
    previous={adjacent.previous}
    next={adjacent.next}
    locale={locale}
    kind={seriesContext ? 'series' : 'post'}
  />
  <RelatedPosts posts={related} locale={locale} />
</BaseLayout>
