---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getLocalePath } from '../config/i18n';
import { useTranslations } from '../i18n/utils';

const locale = 'en';
const t = useTranslations(locale);
const homeHref = getLocalePath(locale, '/');
---

<BaseLayout title="404" description={t('notFound.title')} locale={locale}>
  <section class="py-20">
    <p class="text-sm font-medium text-accent-text">404</p>
    <h1 class="mt-3 text-step-3 font-bold">{t('notFound.title')}</h1>
    <p class="mt-4 text-fg-muted">{t('notFound.description')}</p>
    <a href={homeHref} class="mt-8 inline-flex rounded-base bg-accent px-4 py-2 text-accent-contrast">{t('notFound.action')}</a>
  </section>
</BaseLayout>
