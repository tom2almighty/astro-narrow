---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import PostList from '../../../components/content/PostList.astro';
import PageHeader from '../../../components/content/PageHeader.astro';
import Pagination from '../../../components/ui/Pagination.astro';
import { defaultLocale, locales, type Locale } from '../../../config/i18n';
import { siteConfig } from '../../../config/site';
import {
  excludeSubposts,
  getLocalizedEntries,
  paginateEntries
} from '../../../lib/content/entries';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== defaultLocale)
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const posts = excludeSubposts(await getLocalizedEntries('posts', locale));
const pages = paginateEntries(posts, siteConfig.list.pageSize);
const t = useTranslations(locale);
---

<BaseLayout title={t('posts.title')} description={t('posts.description')} locale={locale}>
  <PageHeader title={t('posts.title')} description={t('posts.description')} locale={locale} />
  <PostList posts={pages[0]} locale={locale} />
  <Pagination current={1} total={pages.length} locale={locale} />
</BaseLayout>
