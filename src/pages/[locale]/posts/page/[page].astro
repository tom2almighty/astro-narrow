---
import BaseLayout from '../../../../components/layout/BaseLayout.astro';
import PostList from '../../../../components/content/PostList.astro';
import PageHeader from '../../../../components/content/PageHeader.astro';
import Pagination from '../../../../components/ui/Pagination.astro';
import { defaultLocale, locales, type Locale } from '../../../../config/i18n';
import { siteConfig } from '../../../../config/site';
import { excludeSubposts, getLocalizedEntries, paginateEntries } from '../../../../lib/content/entries';
import { useTranslations } from '../../../../i18n/utils';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales.filter((item) => item !== defaultLocale)) {
    const posts = excludeSubposts(await getLocalizedEntries('posts', locale));
    const pages = paginateEntries(posts, siteConfig.list.pageSize);
    paths.push(...pages.slice(1).map((entries, index) => ({
      params: { locale, page: String(index + 2) },
      props: { entries, current: index + 2, total: pages.length }
    })));
  }
  return paths;
}

interface Props {
  entries: Array<CollectionEntry<'posts'>>;
  current: number;
  total: number;
}

const locale = Astro.params.locale as Locale;
const { entries, current, total } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout title={`${t('posts.title')} · ${current}`} description={t('posts.description')} locale={locale}>
  <PageHeader title={t('posts.title')} description={t('posts.description')} locale={locale} />
  <PostList posts={entries} locale={locale} />
  <Pagination current={current} total={total} locale={locale} />
</BaseLayout>
