---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { defaultLocale } from '../config/i18n';
import HomePage from '../components/home/HomePage.astro';
import { siteConfig } from '../config/site';
import { excludeSubposts, getLocalizedEntries } from '../lib/content/entries';

const locale = defaultLocale;
const { recentPosts } = siteConfig.home;

const posts = recentPosts.enabled
  ? excludeSubposts(await getLocalizedEntries('posts', locale)).slice(0, recentPosts.limit)
  : [];
---

<BaseLayout title={siteConfig.name} description={siteConfig.description} locale={locale}>
  <HomePage locale={locale} recentPosts={posts} />
</BaseLayout>
