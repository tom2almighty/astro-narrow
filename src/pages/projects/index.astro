---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import ProjectGrid from '../../components/content/ProjectGrid.astro';
import PageHeader from '../../components/content/PageHeader.astro';
import { getLocalizedEntries } from '../../lib/content/entries';
import { sortProjects } from '../../lib/content/projects';
import { useTranslations } from '../../i18n/utils';

const locale = 'en';
const projects = sortProjects(await getLocalizedEntries('projects', locale), locale);
const t = useTranslations(locale);
---

<BaseLayout title={t('projects.title')} description={t('projects.description')} locale={locale}>
  <PageHeader title={t('projects.title')} description={t('projects.description')} locale={locale} />
  <ProjectGrid projects={projects} />
</BaseLayout>
